# Mẫu biến môi trường cho môi trường dev. Sao chép thành .env và điền giá trị.
# KHÔNG commit file .env.

# ---------- Chung ----------
NODE_ENV=development

# ---------- PostgreSQL ----------
CORE_DATABASE_URL=postgresql://app:app@localhost:5432/core
AI_DATABASE_URL=postgresql://app:app@localhost:5432/ai

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379

# ---------- Object storage (MinIO khi dev) ----------
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=media
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---------- core-service ----------
CORE_PORT=3001
JWT_PRIVATE_KEY_PATH=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
INTERNAL_SERVICE_TOKEN=

# ---------- ai-service ----------
AI_PORT=3002
CORE_INTERNAL_URL=http://localhost:3001/internal/v1
CORE_JWKS_URL=http://localhost:3001/.well-known/jwks.json
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ---------- web ----------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
