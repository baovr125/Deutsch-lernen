{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:deutsch-lernen:content:common",
  "title": "Định nghĩa dùng chung cho nội dung học",
  "description": "Các kiểu dữ liệu dùng lại giữa course, unit, lesson và grammar topic. Áp dụng cho mọi cấp độ; trường level phân biệt A1…C2.",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "kebab-case, chữ thường, không dấu"
    },
    "level": { "enum": ["A1", "A2", "B1", "B2", "C1", "C2"] },
    "skill": {
      "enum": ["vocabulary", "grammar", "pronunciation", "listening", "reading", "speaking", "writing"]
    },
    "register": { "enum": ["formal", "informal", "neutral"] },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "description": "Nguồn gốc nội dung: theo trình tự giáo trình (netzwerk-neu) hay nội dung tự biên soạn bổ sung (supplement). Nội dung luôn là tự biên soạn; trường này chỉ ghi phần giáo trình mà bài học tương ứng.",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["netzwerk-neu", "supplement"] },
        "kapitel": { "type": "integer", "minimum": 1, "maximum": 12 },
        "sections": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } },
        "note_vi": { "type": "string" }
      },
      "additionalProperties": false,
      "if": { "properties": { "type": { "const": "netzwerk-neu" } } },
      "then": { "required": ["type", "kapitel", "sections"] }
    },
    "example": {
      "type": "object",
      "required": ["de", "vi"],
      "properties": {
        "de": { "$ref": "#/$defs/nonEmptyString" },
        "vi": { "$ref": "#/$defs/nonEmptyString" },
        "ipa": { "type": "string" },
        "note_vi": { "type": "string" }
      },
      "additionalProperties": false
    },
    "dialogueLine": {
      "type": "object",
      "required": ["speaker", "de", "vi"],
      "properties": {
        "speaker": { "$ref": "#/$defs/nonEmptyString" },
        "de": { "$ref": "#/$defs/nonEmptyString" },
        "vi": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    },
    "rubricCriterion": {
      "type": "object",
      "required": ["criterion_vi", "points"],
      "properties": {
        "criterion_vi": { "$ref": "#/$defs/nonEmptyString" },
        "points": { "type": "integer", "minimum": 1 },
        "description_vi": { "type": "string" }
      },
      "additionalProperties": false
    },
    "exerciseItem": {
      "type": "object",
      "required": ["id", "explanation_vi"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "prompt": { "type": "string" },
        "prompt_vi": { "type": "string" },
        "options": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
        "answer": {},
        "accept": { "type": "array" },
        "pairs": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["left", "right"],
            "properties": {
              "left": { "$ref": "#/$defs/nonEmptyString" },
              "right": { "$ref": "#/$defs/nonEmptyString" }
            },
            "additionalProperties": false
          }
        },
        "tokens": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
        "tts": { "type": "string", "description": "Văn bản để tạo audio (TTS) cho câu hỏi nghe/chính tả" },
        "model_answer": { "type": "string" },
        "explanation_vi": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    },
    "exercise": {
      "type": "object",
      "required": ["id", "type", "skill", "objectives", "difficulty", "instructions_vi", "items"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": {
          "enum": [
            "multiple-choice", "true-false", "gap-fill", "matching", "ordering",
            "translation", "sentence-building", "dictation", "writing", "speaking"
          ]
        },
        "skill": { "$ref": "#/$defs/skill" },
        "objectives": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } },
        "difficulty": { "enum": [1, 2, 3] },
        "instructions_vi": { "type": "string", "minLength": 5 },
        "instructions_de": { "type": "string" },
        "direction": { "enum": ["de-vi", "vi-de"] },
        "stimulus": { "$ref": "#/$defs/id" },
        "grading": { "enum": ["auto", "self", "ai"] },
        "rubric": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/rubricCriterion" } },
        "tip_vi": { "type": "string" },
        "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/exerciseItem" } }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "multiple-choice" } } },
          "then": { "properties": { "items": { "items": { "required": ["prompt", "options", "answer"], "properties": { "answer": { "type": "string" } } } } } }
        },
        {
          "if": { "properties": { "type": { "const": "true-false" } } },
          "then": { "properties": { "items": { "items": { "required": ["prompt", "answer"], "properties": { "answer": { "type": "boolean" } } } } } }
        },
        {
          "if": { "properties": { "type": { "const": "gap-fill" } } },
          "then": { "properties": { "items": { "items": { "required": ["prompt", "answer"], "properties": { "answer": { "type": "array", "minItems": 1, "items": { "type": "string" } } } } } } }
        },
        {
          "if": { "properties": { "type": { "const": "matching" } } },
          "then": { "properties": { "items": { "items": { "required": ["pairs"] } } } }
        },
        {
          "if": { "properties": { "type": { "const": "ordering" } } },
          "then": { "properties": { "items": { "items": { "required": ["tokens", "answer"], "properties": { "answer": { "type": "string" } } } } } }
        },
        {
          "if": { "properties": { "type": { "enum": ["translation", "sentence-building"] } } },
          "then": { "properties": { "items": { "items": { "required": ["prompt", "answer"], "properties": { "answer": { "type": "string" } } } } } }
        },
        {
          "if": { "properties": { "type": { "const": "translation" } } },
          "then": { "required": ["direction"] }
        },
        {
          "if": { "properties": { "type": { "const": "dictation" } } },
          "then": { "properties": { "items": { "items": { "required": ["tts", "answer"], "properties": { "answer": { "type": "string" } } } } } }
        },
        {
          "if": { "properties": { "type": { "enum": ["writing", "speaking"] } } },
          "then": {
            "required": ["grading", "rubric"],
            "properties": {
              "grading": { "enum": ["self", "ai"] },
              "items": { "items": { "required": ["prompt", "model_answer"] } }
            }
          }
        }
      ]
    }
  }
}
