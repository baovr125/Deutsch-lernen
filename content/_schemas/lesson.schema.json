{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:deutsch-lernen:content:lesson",
  "title": "Lesson (bài học) hoặc Review (bài ôn tập cuối Kapitel)",
  "description": "File: content/<level>/units/<NN>-<slug>/lesson-NN.yaml hoặc review.yaml",
  "type": "object",
  "required": [
    "id", "kind", "level", "unit", "order", "title_de", "title_vi", "topic_vi", "source",
    "cefr", "objectives", "estimated_minutes", "prerequisites", "intro_vi",
    "vocabulary", "grammar", "redemittel", "pronunciation", "examples", "skills",
    "exercises", "summary_vi", "self_check"
  ],
  "properties": {
    "id": { "$ref": "urn:deutsch-lernen:content:common#/$defs/id" },
    "kind": { "enum": ["lesson", "review"] },
    "level": { "$ref": "urn:deutsch-lernen:content:common#/$defs/level" },
    "unit": { "$ref": "urn:deutsch-lernen:content:common#/$defs/id" },
    "order": { "type": "integer", "minimum": 1 },
    "title_de": { "type": "string", "minLength": 1 },
    "title_vi": { "type": "string", "minLength": 1 },
    "topic_vi": { "type": "string", "minLength": 1 },
    "source": { "$ref": "urn:deutsch-lernen:content:common#/$defs/source" },
    "cefr": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^A1\\.(H|L|SI|SP|S)[0-9]+$" },
      "description": "Mã can-do CEFR trong content/<level>/cefr-<level>.yaml"
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "vi"],
        "properties": {
          "id": { "type": "string", "pattern": "^o[0-9]+$" },
          "vi": { "type": "string", "minLength": 5 }
        },
        "additionalProperties": false
      }
    },
    "estimated_minutes": { "type": "integer", "minimum": 10, "maximum": 240 },
    "prerequisites": { "type": "array", "items": { "$ref": "urn:deutsch-lernen:content:common#/$defs/id" } },
    "intro_vi": { "type": "string", "minLength": 20 },
    "vocabulary": {
      "type": "object",
      "required": ["file", "new", "review"],
      "properties": {
        "file": { "type": "string", "pattern": "^vocabulary/[a-z0-9-]+\\.csv$" },
        "new": { "type": "array", "items": { "$ref": "urn:deutsch-lernen:content:common#/$defs/id" } },
        "review": { "type": "array", "items": { "$ref": "urn:deutsch-lernen:content:common#/$defs/id" } }
      },
      "additionalProperties": false
    },
    "grammar": {
      "type": "object",
      "required": ["topics", "notes"],
      "properties": {
        "topics": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["topic", "focus_vi"],
            "properties": {
              "topic": { "$ref": "urn:deutsch-lernen:content:common#/$defs/id" },
              "focus_vi": { "type": "string", "minLength": 5 }
            },
            "additionalProperties": false
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title_vi", "explanation_vi", "examples"],
            "properties": {
              "title_vi": { "type": "string", "minLength": 3 },
              "explanation_vi": { "type": "string", "minLength": 10 },
              "examples": { "type": "array", "minItems": 1, "items": { "$ref": "urn:deutsch-lernen:content:common#/$defs/example" } }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "redemittel": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "de", "vi", "context_vi", "register", "dialogue"],
        "properties": {
          "id": { "$ref": "urn:deutsch-lernen:content:common#/$defs/id" },
          "de": { "type": "string", "minLength": 1 },
          "vi": { "type": "string", "minLength": 1 },
          "context_vi": { "type": "string", "minLength": 5 },
          "register": { "$ref": "urn:deutsch-lernen:content:common#/$defs/register" },
          "dialogue": { "type": "array", "minItems": 2, "items": { "$ref": "urn:deutsch-lernen:content:common#/$defs/dialogueLine" } }
        },
        "additionalProperties": false
      }
    },
    "pronunciation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "focus_vi", "explanation_vi", "examples", "practice_vi"],
        "properties": {
          "id": { "$ref": "urn:deutsch-lernen:content:common#/$defs/id" },
          "focus_vi": { "type": "string", "minLength": 3 },
          "explanation_vi": { "type": "string", "minLength": 10 },
          "examples": { "type": "array", "minItems": 1, "items": { "$ref": "urn:deutsch-lernen:content:common#/$defs/example" } },
          "practice_vi": { "type": "string", "minLength": 5 }
        },
        "additionalProperties": false
      }
    },
    "examples": { "type": "array", "minItems": 1, "items": { "$ref": "urn:deutsch-lernen:content:common#/$defs/example" } },
    "skills": {
      "type": "object",
      "required": ["listening", "reading", "speaking", "writing"],
      "properties": {
        "listening": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "title_vi", "situation_vi", "audio", "script", "exercises"],
            "properties": {
              "id": { "$ref": "urn:deutsch-lernen:content:common#/$defs/id" },
              "title_vi": { "type": "string" },
              "situation_vi": { "type": "string" },
              "audio": {
                "type": "object",
                "required": ["status"],
                "properties": {
                  "status": { "enum": ["pending-tts", "recorded"] },
                  "file": { "type": "string" },
                  "speed": { "enum": ["slow", "normal"] }
                },
                "additionalProperties": false
              },
              "script": { "type": "array", "minItems": 1, "items": { "$ref": "urn:deutsch-lernen:content:common#/$defs/dialogueLine" } },
              "exercises": { "type": "array", "items": { "$ref": "urn:deutsch-lernen:content:common#/$defs/id" } }
            },
            "additionalProperties": false
          }
        },
        "reading": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "title_vi", "text_type_vi", "text_de", "translation_vi", "exercises"],
            "properties": {
              "id": { "$ref": "urn:deutsch-lernen:content:common#/$defs/id" },
              "title_vi": { "type": "string" },
              "text_type_vi": { "type": "string" },
              "text_de": { "type": "string", "minLength": 10 },
              "translation_vi": { "type": "string", "minLength": 10 },
              "glossary": { "type": "array", "items": { "$ref": "urn:deutsch-lernen:content:common#/$defs/example" } },
              "exercises": { "type": "array", "items": { "$ref": "urn:deutsch-lernen:content:common#/$defs/id" } }
            },
            "additionalProperties": false
          }
        },
        "speaking": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "title_vi", "task_vi", "steps_vi", "model", "exercises"],
            "properties": {
              "id": { "$ref": "urn:deutsch-lernen:content:common#/$defs/id" },
              "title_vi": { "type": "string" },
              "task_vi": { "type": "string" },
              "steps_vi": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "model": { "type": "array", "minItems": 1, "items": { "$ref": "urn:deutsch-lernen:content:common#/$defs/dialogueLine" } },
              "exercises": { "type": "array", "items": { "$ref": "urn:deutsch-lernen:content:common#/$defs/id" } }
            },
            "additionalProperties": false
          }
        },
        "writing": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "title_vi", "task_vi", "model_de", "model_vi", "checklist_vi", "exercises"],
            "properties": {
              "id": { "$ref": "urn:deutsch-lernen:content:common#/$defs/id" },
              "title_vi": { "type": "string" },
              "task_vi": { "type": "string" },
              "model_de": { "type": "string" },
              "model_vi": { "type": "string" },
              "checklist_vi": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "exercises": { "type": "array", "items": { "$ref": "urn:deutsch-lernen:content:common#/$defs/id" } }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "exercises": { "type": "array", "minItems": 1, "items": { "$ref": "urn:deutsch-lernen:content:common#/$defs/exercise" } },
    "summary_vi": { "type": "string", "minLength": 20 },
    "self_check": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 5 } }
  },
  "additionalProperties": false
}
