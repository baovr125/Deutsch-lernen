{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:deutsch-lernen:content:v2:course",
  "title": "Course v2 — lộ trình học của một cấp độ (trỏ tới các module)",
  "description": "File: content/<level>/course.yaml",
  "type": "object",
  "required": [
    "id",
    "level",
    "title_vi",
    "description_vi",
    "primary_source",
    "path",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "level": {
      "enum": [
        "A1",
        "A2",
        "B1",
        "B2",
        "C1",
        "C2"
      ]
    },
    "title_de": {
      "type": "string"
    },
    "title_vi": {
      "type": "string",
      "minLength": 1
    },
    "description_vi": {
      "type": "string",
      "minLength": 20
    },
    "primary_source": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "verified_from"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "isbn": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "edition_note_vi": {
          "type": "string"
        },
        "verified_from": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "path": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "order",
          "kind",
          "title_de",
          "title_vi",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "order": {
            "type": "integer",
            "minimum": 0
          },
          "kind": {
            "enum": [
              "intro",
              "kapitel",
              "plattform",
              "final-assessment"
            ]
          },
          "kapitel": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "covers": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "title_de": {
            "type": "string"
          },
          "title_vi": {
            "type": "string"
          },
          "module": {
            "type": "string",
            "pattern": "^modules/([mp][0-9]{1,2}|f)-[a-z0-9-]+$",
            "description": "Đường dẫn tới thư mục module (Content Standard v2)"
          },
          "status": {
            "enum": [
              "ready",
              "draft",
              "planned"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "status": {
      "enum": [
        "ready",
        "in-progress",
        "planned"
      ]
    }
  },
  "additionalProperties": false
}