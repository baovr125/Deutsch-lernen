            "auto",
            "self",
            "ai"
          ]
        },
        "rubric": {
          "$ref": "#/$defs/rubric"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "multiple-choice",
                  "reading-comprehension",
                  "listening-practice"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "items": {
                "items": {
                  "$ref": "#/$defs/itemChoice"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "true-false"
              }
            }
          },
          "then": {
            "properties": {
              "items": {
                "items": {
                  "$ref": "#/$defs/itemBool"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "fill-blank"
              }
            }
          },
          "then": {
            "properties": {
              "items": {
                "items": {
                  "$ref": "#/$defs/itemFill"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "matching"
              }
            }
          },
          "then": {
            "properties": {
              "items": {
                "items": {
                  "$ref": "#/$defs/itemMatch"
                },
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "word-order"
              }
            }
          },
          "then": {
            "properties": {
              "items": {
                "items": {
                  "$ref": "#/$defs/itemOrder"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "translation"
              }
            }
          },
          "then": {
            "properties": {
              "items": {
                "items": {
                  "$ref": "#/$defs/itemTranslate"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "sentence-construction"
              }
            }
          },
          "then": {
            "properties": {
              "items": {
                "items": {
                  "$ref": "#/$defs/itemConstruct"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "dictation"
              }
            }
          },
          "then": {
            "properties": {
              "items": {
                "items": {
                  "$ref": "#/$defs/itemDictation"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "writing-practice",
                  "speaking-practice"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "items": {
                "items": {
                  "$ref": "#/$defs/itemOpen"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "listening-practice"
              }
            }
          },
          "then": {
            "required": [
              "stimulus"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "reading-comprehension"
              }
            }
          },
          "then": {
            "required": [
              "stimulus"
            ]
          }
        }
      ]
    },
