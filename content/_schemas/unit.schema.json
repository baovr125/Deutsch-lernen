{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:deutsch-lernen:content:unit",
  "title": "Unit — một Kapitel của giáo trình, hoặc phần nhập môn",
  "description": "File: content/<level>/units/<NN>-<slug>/unit.yaml",
  "type": "object",
  "required": ["id", "level", "order", "kind", "title_de", "title_vi", "source", "summary_vi", "cefr", "lessons", "estimated_minutes", "status"],
  "properties": {
    "id": { "$ref": "urn:deutsch-lernen:content:common#/$defs/id" },
    "level": { "$ref": "urn:deutsch-lernen:content:common#/$defs/level" },
    "order": { "type": "integer", "minimum": 0 },
    "kind": { "enum": ["intro", "kapitel"] },
    "title_de": { "type": "string", "minLength": 1 },
    "title_vi": { "type": "string", "minLength": 1 },
    "source": { "$ref": "urn:deutsch-lernen:content:common#/$defs/source" },
    "summary_vi": { "type": "string", "minLength": 20 },
    "cefr": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^A1\\.(H|L|SI|SP|S)[0-9]+$" } },
    "lessons": { "type": "array", "minItems": 1, "items": { "$ref": "urn:deutsch-lernen:content:common#/$defs/id" } },
    "review": { "$ref": "urn:deutsch-lernen:content:common#/$defs/id" },
    "grammar_topics": { "type": "array", "items": { "type": "string" } },
    "vocabulary_file": { "type": "string", "pattern": "^vocabulary/[a-z0-9-]+\\.csv$" },
    "estimated_minutes": { "type": "integer", "minimum": 30 },
    "status": { "enum": ["ready", "draft", "planned"] },
    "not_covered_vi": { "type": "array", "items": { "type": "string" }, "description": "Phần của Kapitel chưa/không đưa vào nền tảng và lý do" }
  },
  "additionalProperties": false
}
